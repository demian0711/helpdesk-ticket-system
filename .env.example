# Demo values for local development. Copy this file to .env.
# Compose uses the first three values to initialize PostgreSQL.
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_demo
# Host port used by both Compose and Spring Boot.
POSTGRES_PORT=5432

# Enable demo accounts for local development only.
HELPDESK_DEMO_ENABLED=false
